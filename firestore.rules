rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'naren.papanaboina@gmail.com' ||
        request.auth.token.email == 'vasu.kannaluri@gmail.com'
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Config: readable by anyone, only admin can write
    match /config/{configDoc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Categories: readable by anyone, admin can write
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Users: signed-in users can read profiles for contact & sellers; owners can write their own
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId) && request.resource.data.uid == userId;
      allow update: if (isOwner(userId) && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['isVerified', 'isBanned']))) || isAdmin();
      allow delete: if isOwner(userId) || isAdmin();
    }

    // Listings: public read of active listings, owner or admin can edit/delete, validate field types and lengths
    match /listings/{listingId} {
      allow read: if true;
      allow create: if isSignedIn() 
        && request.resource.data.sellerId == request.auth.uid
        && request.resource.data.title is string 
        && request.resource.data.title.size() <= 60
        && request.resource.data.price is number
        && (!('description' in request.resource.data) || request.resource.data.description.size() <= 400);
      allow update: if isSignedIn() 
        && (resource.data.sellerId == request.auth.uid || isAdmin())
        && (!('title' in request.resource.data) || (request.resource.data.title is string && request.resource.data.title.size() <= 60));
      allow delete: if isSignedIn() && (resource.data.sellerId == request.auth.uid || isAdmin());
    }

    // Chats: only participants can read and write
    match /chats/{chatId} {
      allow read: if isSignedIn() && (resource.data.participants.hasAny([request.auth.uid]) || isAdmin());
      allow create: if isSignedIn() && request.resource.data.participants.hasAny([request.auth.uid]);
      allow update: if isSignedIn() && (resource.data.participants.hasAny([request.auth.uid]) || isAdmin());
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if isSignedIn() && (get(/databases/$(database)/documents/chats/$(chatId)).data.participants.hasAny([request.auth.uid]) || isAdmin());
        allow create: if isSignedIn() && request.resource.data.senderId == request.auth.uid;
        allow update, delete: if isAdmin();
      }
    }

    // Reports: signed in user can submit report, only admin can view & update
    match /reports/{reportId} {
      allow read: if isAdmin();
      allow create: if isSignedIn() && request.resource.data.reporterId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Saved Items: only user can view/manage their saved items
    match /savedItems/{saveId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }
  }
}
