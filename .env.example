# GEMINI_API_KEY: Required for Gemini AI API calls (if enabled).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# FIREBASE CONFIGURATION:
# Managed via firebase-applet-config.json.
# In a local development or GitHub export environment, fill in your Firebase project credentials in firebase-applet-config.json:
# - projectId
# - appId
# - apiKey
# - authDomain
# - firestoreDatabaseId
# - storageBucket
