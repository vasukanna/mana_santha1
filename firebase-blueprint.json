{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile in SanthaKart marketplace",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 100 },
        "phone": { "type": "string", "maxLength": 20 },
        "email": { "type": "string", "maxLength": 150 },
        "village": { "type": "string", "maxLength": 100 },
        "mandal": { "type": "string", "maxLength": 100 },
        "district": { "type": "string", "maxLength": 100 },
        "role": { "type": "string", "enum": ["seller", "buyer", "both"] },
        "plan": { "type": "string", "enum": ["free", "premium", "dealer"] },
        "planExpiry": { "type": "string", "maxLength": 50 },
        "isVerified": { "type": "boolean" },
        "isBanned": { "type": "boolean" },
        "createdAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["uid", "name", "phone", "district", "role"]
    },
    "Listing": {
      "title": "Listing",
      "description": "Marketplace listing for livestock, crops, machinery, land, etc.",
      "type": "object",
      "properties": {
        "sellerId": { "type": "string", "maxLength": 128 },
        "sellerName": { "type": "string", "maxLength": 100 },
        "sellerPhone": { "type": "string", "maxLength": 20 },
        "category": { "type": "string", "maxLength": 60 },
        "subcategory": { "type": "string", "maxLength": 60 },
        "title": { "type": "string", "maxLength": 150 },
        "description": { "type": "string", "maxLength": 2000 },
        "price": { "type": "number" },
        "negotiable": { "type": "boolean" },
        "quantity": { "type": "string", "maxLength": 80 },
        "images": { "type": "array" },
        "video": { "type": "string", "maxLength": 1000 },
        "district": { "type": "string", "maxLength": 100 },
        "mandal": { "type": "string", "maxLength": 100 },
        "village": { "type": "string", "maxLength": 100 },
        "status": { "type": "string", "enum": ["active", "sold", "removed"] },
        "featured": { "type": "boolean" },
        "customFields": { "type": "object" },
        "createdAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["sellerId", "title", "category", "price", "district", "status"]
    },
    "Chat": {
      "title": "Chat",
      "description": "Conversation between buyer and seller regarding a listing",
      "type": "object",
      "properties": {
        "listingId": { "type": "string", "maxLength": 128 },
        "listingTitle": { "type": "string", "maxLength": 150 },
        "listingImage": { "type": "string", "maxLength": 500 },
        "participants": { "type": "array" },
        "participantNames": { "type": "object" },
        "lastMessage": { "type": "string", "maxLength": 500 },
        "lastMessageAt": { "type": "string", "maxLength": 50 },
        "unreadCount": { "type": "object" }
      },
      "required": ["participants", "listingId"]
    },
    "Message": {
      "title": "Message",
      "description": "Individual message inside a chat thread",
      "type": "object",
      "properties": {
        "chatId": { "type": "string", "maxLength": 128 },
        "senderId": { "type": "string", "maxLength": 128 },
        "senderName": { "type": "string", "maxLength": 100 },
        "text": { "type": "string", "maxLength": 1000 },
        "createdAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["chatId", "senderId", "text"]
    },
    "Report": {
      "title": "Report",
      "description": "User report for offensive content or fraudulent listings",
      "type": "object",
      "properties": {
        "reporterId": { "type": "string", "maxLength": 128 },
        "listingId": { "type": "string", "maxLength": 128 },
        "reportedUserId": { "type": "string", "maxLength": 128 },
        "reason": { "type": "string", "maxLength": 500 },
        "details": { "type": "string", "maxLength": 1000 },
        "status": { "type": "string", "enum": ["pending", "resolved", "dismissed"] },
        "createdAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["reporterId", "listingId", "reason"]
    },
    "SavedItem": {
      "title": "SavedItem",
      "description": "Bookmarked listings for a user",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "listingId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["userId", "listingId"]
    },
    "AppConfig": {
      "title": "AppConfig",
      "description": "Application settings and free trial configuration",
      "type": "object",
      "properties": {
        "subscriptionEnabled": { "type": "boolean" },
        "freeUntil": { "type": "string", "maxLength": 50 },
        "featuredPrice": { "type": "number" },
        "premiumPrice": { "type": "number" },
        "freePostLimit": { "type": "number" },
        "freePhotoLimit": { "type": "number" },
        "allowVideoOnFree": { "type": "boolean" }
      }
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles and contact info"
    },
    "/listings/{listingId}": {
      "schema": "Listing",
      "description": "Marketplace listings"
    },
    "/chats/{chatId}": {
      "schema": "Chat",
      "description": "Chat conversations"
    },
    "/chats/{chatId}/messages/{messageId}": {
      "schema": "Message",
      "description": "Messages within a chat"
    },
    "/reports/{reportId}": {
      "schema": "Report",
      "description": "User content reports"
    },
    "/savedItems/{saveId}": {
      "schema": "SavedItem",
      "description": "Saved listings for quick access"
    },
    "/config/{configDoc}": {
      "schema": "AppConfig",
      "description": "System config and feature toggles"
    }
  }
}
